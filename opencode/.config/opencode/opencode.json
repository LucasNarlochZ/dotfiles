{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "formatter": {
    "ruff": {
      "command": [
        "sh",
        "-c",
        "uv run ruff check --fix \"$1\" && uv run ruff format \"$1\"",
        "_",
        "$FILE"
      ],
      "extensions": [".py", ".pyi"]
    }
  },
  "lsp": true,
  "mcp": {
    "serper": {
      "type": "local",
      "command": ["npx", "-y", "serper-search-scrape-mcp-server"],
      "environment": {
        "SERPER_API_KEY": "{env:SERPER_API_KEY}"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "/usr/bin/npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "trello": {
      "type": "local",
      "command": ["npx", "-y", "@delorenj/mcp-server-trello"],
      "enabled": true,
      "environment": {
        "TRELLO_API_KEY": "{env:TRELLO_API_KEY}",
        "TRELLO_TOKEN": "{env:TRELLO_TOKEN}"
      }
    },
    "clickup": {
      "type": "remote",
      "url": "https://mcp.clickup.com/mcp",
      "enabled": true
    },
    "ai-memory": {
      "type": "remote",
      "url": "http://127.0.0.1:49374/mcp",
      "enabled": true
    },
    "google-calendar": {
      "type": "remote",
      "url": "https://calendarmcp.googleapis.com/mcp/v1",
      "oauth": {
        "clientId": "{env:GOOGLE_CLIENT_ID}",
        "clientSecret": "{env:GOOGLE_CLIENT_SECRET}"
      }
    }
  },
  "command": {}
}
